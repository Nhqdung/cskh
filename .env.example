# ==============================================================================
# PERSONAL CSKH REPORTING ASSISTANT - ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Application General
APP_ENV=development                # development | production | demo
APP_TIMEZONE=Asia/Ho_Chi_Minh
DATA_DIR=data
DB_NAME=cskh_assistant.db
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
DATA_RETENTION_DAYS=60             # Number of days to retain message history

# Employee / User Information
EMPLOYEE_NAME=Nguyen Van A         # Tên nhân viên xuất hiện trên báo cáo

# Discord Bot Integration (Official Discord Bot API)
# Bot requires: View Channels, Read Message History, Message Content Intent
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_USER_ID=your_discord_user_id_here
DISCORD_GUILD_IDS=guild_id_1,guild_id_2
DISCORD_ALLOWED_CHANNEL_IDS=channel_id_1,channel_id_2,ticket_channel_id_3

# Meta Business Suite Integration (Official Meta Graph API)
# Requires Page Access Token with pages_read_engagement, pages_manage_metadata, pages_messaging
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_PAGE_ID=your_page_id_here
META_PAGE_ACCESS_TOKEN=your_page_access_token_here
META_GRAPH_API_VERSION=v20.0
# Webhook settings (optional, for real-time Meta updates behind public HTTPS tunnel)
META_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token
META_WEBHOOK_PORT=8080

# Google Gemini API
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash    # gemini-2.5-flash or gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# Shift Configurations (24h format HH:MM in Asia/Ho_Chi_Minh)
SHIFT_1_NAME=Ca 1
SHIFT_1_START=07:00
SHIFT_1_END=15:00

SHIFT_2_NAME=Ca 2
SHIFT_2_START=15:00
SHIFT_2_END=23:00

# Ca 3 crosses midnight (23:00 to 07:00 next day)
SHIFT_3_NAME=Ca 3
SHIFT_3_START=23:00
SHIFT_3_END=07:00
